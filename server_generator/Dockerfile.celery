FROM python:3.12-slim as builder

WORKDIR /app

# Install only essential build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.celery.txt .
RUN pip install --upgrade pip && pip install --prefix=/install -r requirements.celery.txt

FROM python:3.12-slim

WORKDIR /app

# Copy only the installed packages from builder
COPY --from=builder /install /usr/local

# Copy only the necessary application files
COPY celery_config.py .
COPY tasks/ ./tasks/
COPY services/ ./services/
COPY models/ ./models/
COPY config.py .

# Create static directory
RUN mkdir -p static/images

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["celery", "-A", "celery_config.celery_app", "worker", "--loglevel=info", "--concurrency=1"]
